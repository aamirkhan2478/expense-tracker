# ─────────────────────────────────────────────────────────────
# Core
# ─────────────────────────────────────────────────────────────
MONGODB_URI=< Your MongoDB URI >
JWT_SECRET=< Long random string used to sign auth tokens >
JWT_EXPIRE=7d

# Public base URL of the deployment.
# Used for metadataBase, canonical URLs, sitemap.xml, robots.txt, OG images,
# axios baseURL, and links inside transactional emails.
# Production: https://spendwise.smartinvoicegen.online
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# Email delivery (Resend or SMTP)
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY=< Your Resend API key >
EMAIL_FROM_EMAIL=< Verified sender address, e.g. no-reply@spendwise.smartinvoicegen.online >
EMAIL_FROM_NAME=SpendWise
EMAIL_SUPPORT_EMAIL=support@spendwise.smartinvoicegen.online

EMAIL_CONCURRENCY=3
EMAIL_MAX_RETRIES=3
EMAIL_RETRY_DELAY_MS=5000

# SMTP is used only when RESEND_API_KEY is not set.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# Days to retain email delivery logs (recipient, rendered HTML, delivery
# metadata). A MongoDB TTL index deletes each log after this many days.
# Leave unset to use the 90-day default.
# EMAIL_LOG_RETENTION_DAYS=90

# ─────────────────────────────────────────────────────────────
# Scheduled emails
# ─────────────────────────────────────────────────────────────
# Shared secret sent as `Authorization: Bearer <CRON_SECRET>` by the scheduler.
# REQUIRED in production: /api/cron/scheduled-emails returns 500 without it.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRON_SECRET=

# ─────────────────────────────────────────────────────────────
# Admin seed (used by scripts/seed-admin.js)
# ─────────────────────────────────────────────────────────────
# ADMIN_EMAIL=admin@spendwise.app
# ADMIN_PASSWORD=admin123!
# ADMIN_NAME=Admin
